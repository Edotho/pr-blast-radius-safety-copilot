# Daytona: create an API key from your Daytona account.
DAYTONA_API_KEY=

# Neo4j: matches the local demo database in docker-compose.yml.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=daytona-demo-only
NEO4J_DATABASE=neo4j

# Nosana OpenAI-compatible inference API. Check /models for currently served models.
NOSANA_BASE_URL=https://inference.nosana.com/v1
NOSANA_API_KEY=
NOSANA_MODEL=qwen/qwen3.8-27b
